    # ---------- Earley / CYK 图表判定 ----------

    def _chart_precheck(self):
        text_mode = self._text_mode
        source = self._input
        tokens = []
        while self._current.type != TOKEN_END:
            tokens.append(self._current.type)
            status = self._advance()
            if status != STATUS_OK:
                return status
        if text_mode:
            status = self._prepare_text(source)
        else:
            self._token_pos = 0
            status = self._advance()
        if status != STATUS_OK:
            return status
        accepted = (self._earley_accept(tokens) if {% if earley %}True{% else %}False{% endif %}
                    else self._cyk_accept(tokens))
        if not accepted:
            self._set_error(STATUS_ERR_SYNTAX, self._current.line,
                            self._current.column, "没有可接受的解析路径")
            return STATUS_ERR_SYNTAX
        return STATUS_OK

    def _earley_add(self, chart, waiting, position, item):
        """加入一个 Earley 项，并在当前位置登记它期待的非终结符。"""
        if item in chart[position]:
            return False
        chart[position].add(item)
        production, dot, origin = item
        if dot < _CHART_RHS_LENGTH[production]:
            symbol = _CHART_RHS_SYMBOLS[_CHART_RHS_START[production] + dot]
            if symbol >= _TERMINAL_COUNT:
                waiting[position].setdefault(symbol, set()).add(item)
        return True

    def _earley_accept(self, tokens):
        count = len(tokens)
        chart = [set() for _ in range(count + 1)]
        # waiting[pos][符号] = 该位置期待此非终结符的项；completer 不再扫描
        # 整个 chart[origin]，只找真正等着这条归约结果的父项。
        waiting = [dict() for _ in range(count + 1)]
        for production in range(_CHART_PRODUCTION_COUNT):
            if _CHART_LHS[production] == _CHART_START:
                self._earley_add(chart, waiting, 0, (production, 0, 0))
        for position in range(count + 1):
            changed = True
            while changed:
                changed = False
                for production, dot, origin in tuple(chart[position]):
                    length = _CHART_RHS_LENGTH[production]
                    if dot == length:
                        completed = _TERMINAL_COUNT + _CHART_LHS[production]
                        parents = waiting[origin].get(completed)
                        if parents:
                            for parent, parent_dot, parent_origin in tuple(
                                    parents):
                                if self._earley_add(
                                        chart, waiting, position,
                                        (parent, parent_dot + 1,
                                         parent_origin)):
                                    changed = True
                        continue
                    symbol = _CHART_RHS_SYMBOLS[_CHART_RHS_START[production] + dot]
                    if symbol >= _TERMINAL_COUNT:
                        nonterm = symbol - _TERMINAL_COUNT
                        for next_prod in _CHART_BY_LHS[nonterm]:
                            if self._earley_add(chart, waiting, position,
                                                (next_prod, 0, position)):
                                changed = True
                    elif position < count and symbol == tokens[position]:
                        if self._earley_add(chart, waiting, position + 1,
                                            (production, dot + 1, origin)):
                            changed = True
        return any(_CHART_LHS[p] == _CHART_START and origin == 0 and
                   dot == _CHART_RHS_LENGTH[p] for p, dot, origin in chart[count])

    def _cyk_accept(self, tokens):
        count = len(tokens)
        if count == 0:
            return _CHART_ACCEPTS_EMPTY
        cells = [[set() for _ in range(count + 1)] for _ in range(count)]
        for index, token in enumerate(tokens):
            if token < len(_CHART_UNARY_BY_TOKEN):
                for rule in _CHART_UNARY_BY_TOKEN[token]:
                    cells[index][index + 1].add(_CHART_UNARY_LHS[rule])
        for length in range(2, count + 1):
            for begin in range(count - length + 1):
                end = begin + length
                target = cells[begin][end]
                for middle in range(begin + 1, end):
                    right = cells[middle][end]
                    if not right:
                        continue
                    # 按左部非终结符查候选规则，不再遍历整张二元规则表。
                    for left_symbol in cells[begin][middle]:
                        for rule in _CHART_BINARY_BY_LEFT[left_symbol]:
                            if _CHART_BINARY_RIGHT[rule] in right:
                                target.add(_CHART_BINARY_LHS[rule])
        return _CHART_START in cells[0][count]
